{
  "name": "sovereigns3nc",
  "version": "3.1.0",
  "description": "",
  "main": "dist/index.js",
  "module": "dist/sovereigns3nc.esm.js",
  "unpkg": "dist/sovereigns3nc.global.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sovereigns3nc.esm.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sov": "dist/cli.js",
    "sov-admin": "dist/admin.js"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.config.js",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.integration.config.js",
    "test:docker": "NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.integration.config.js",
    "setup:test-env": "bash dev.sh start",
    "test:browser": "NODE_OPTIONS=--experimental-vm-modules npx playwright test -c tests/playwright.config.ts",
    "build:esm": "esbuild src/index.ts --bundle --minify --platform=browser --outfile=dist/sovereigns3nc.esm.js --sourcemap --format=esm --banner:js=\"/* SovereignS3nc v3.1.0 | ISC License */\" --alias:crypto=crypto-browserify --alias:path=path-browserify --alias:stream=stream-browserify --alias:buffer=buffer --alias:util=util --alias:events=events --alias:assert=assert --alias:process=process/browser --external:fs-extra --external:path --external:fs",
    "build:global": "esbuild src/index.ts --bundle --minify --platform=browser --outfile=dist/sovereigns3nc.global.js --sourcemap --format=iife --global-name=Sovereign --banner:js=\"/* SovereignS3nc v3.1.0 | ISC License */\" --alias:crypto=crypto-browserify --alias:path=path-browserify --alias:stream=stream-browserify --alias:buffer=buffer --alias:util=util --alias:events=events --alias:assert=assert --alias:process=process/browser --external:fs-extra --external:path --external:fs",
    "build:social": "node --no-warnings demo/social/build.js",
    "build:social-local": "node --no-warnings demo/social-local/build.js",
    "build:banky": "node --no-warnings demo/banky/build.js",
    "build:board": "node --no-warnings demo/board/build.js",
    "build:blog": "node --no-warnings demo/blog/build.js",
    "build": "rimraf dist && tsc -p tsconfig.build.json && npm run build:esm && npm run build:global",
    "prepublishOnly": "npm run build",
    "admin-cli": "ts-node src/admin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "files": [
    "dist",
    "docs",
    "README.md",
    "GEMINI.md",
    "AGENT.md"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1013.0",
    "@aws-sdk/util-utf8-node": "^3.259.0",
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.1",
    "crypto-browserify": "^3.12.1",
    "dompurify": "^3.4.5",
    "events": "^3.3.0",
    "fs-extra": "^11.3.3",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.3",
    "marked": "^18.0.4",
    "path-browserify": "^1.0.1",
    "peer": "^1.0.2",
    "peerjs": "^1.5.5",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sql.js": "^1.13.0",
    "stream-browserify": "^3.0.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^6.0.3",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@types/web-bluetooth": "^0.0.21",
    "esbuild": "^0.28.0",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.2.0",
    "jimp": "^1.6.1",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2"
  }
}
