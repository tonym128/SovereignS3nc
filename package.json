{
  "name": "sovereigns3nc",
  "version": "3.2.2",
  "description": "Offline-first, zero-trust encrypted data storage library with S3 synchronization",
  "main": "dist/index.js",
  "module": "dist/sovereigns3nc.esm.js",
  "browser": "dist/sovereigns3nc.esm.js",
  "unpkg": "dist/sovereigns3nc.global.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/sovereigns3nc.esm.js",
      "import": "./dist/sovereigns3nc.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tonym128/SovereignS3nc.git"
  },
  "homepage": "https://github.com/tonym128/SovereignS3nc#readme",
  "bugs": {
    "url": "https://github.com/tonym128/SovereignS3nc/issues"
  },
  "keywords": [
    "offline-first",
    "s3",
    "sync",
    "sqlite",
    "e2ee",
    "encryption",
    "zero-trust",
    "decentralized",
    "indexeddb",
    "storage"
  ],
  "author": "Tony Mobily",
  "license": "ISC",
  "bin": {
    "sov": "dist/cli.js",
    "sov-admin": "dist/admin.js"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.config.js",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.integration.config.js",
    "test:docker": "NODE_OPTIONS=--experimental-vm-modules jest -c tests/jest.integration.config.js",
    "setup:test-env": "bash dev.sh start",
    "test:browser": "NODE_OPTIONS=--experimental-vm-modules npx playwright test -c tests/playwright.config.ts",
    "test:a11y": "NODE_OPTIONS=--experimental-vm-modules npx playwright test -c tests/playwright.a11y.config.ts",
    "test:mutation": "ts-node scripts/mutation-test.ts",
    "build:esm": "esbuild src/index.ts --bundle --minify --platform=browser --outfile=dist/sovereigns3nc.esm.js --sourcemap --format=esm --banner:js=\"/* SovereignS3nc v3.2.2 | ISC License */\" --inject:demo/shared/src/polyfills.js --define:global=globalThis --alias:crypto=crypto-browserify --alias:path=path-browserify --alias:stream=stream-browserify --alias:buffer=buffer --alias:util=util --alias:events=events --alias:assert=assert --alias:process=process/browser --alias:fs-extra=./src/adapters/empty-fs.ts --alias:fs=./src/adapters/empty-fs.ts",
    "build:global": "esbuild src/index.ts --bundle --minify --platform=browser --outfile=dist/sovereigns3nc.global.js --sourcemap --format=iife --global-name=Sovereign --banner:js=\"/* SovereignS3nc v3.2.2 | ISC License */\" --inject:demo/shared/src/polyfills.js --define:global=globalThis --alias:crypto=crypto-browserify --alias:path=path-browserify --alias:stream=stream-browserify --alias:buffer=buffer --alias:util=util --alias:events=events --alias:assert=assert --alias:process=process/browser --alias:fs-extra=./src/adapters/empty-fs.ts --alias:fs=./src/adapters/empty-fs.ts",
    "build:react": "tsc -p packages/react/tsconfig.json && node -e \"require('fs-extra').copySync('packages/react/dist', 'dist/react')\"",
    "build:social": "node --no-warnings demo/social/build.js",
    "build:social-local": "node --no-warnings demo/social-local/build.js",
    "build:banky": "node --no-warnings demo/banky/build.js",
    "build:board": "node --no-warnings demo/board/build.js",
    "build:blog": "node --no-warnings demo/blog/build.js",
    "build:demos": "node --no-warnings scripts/build-demos.js",
    "build": "rimraf dist && tsc -p tsconfig.build.json && npm run build:esm && npm run build:global && npm run build:react",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:video": "ts-node scripts/generate-video.ts",
    "prepublishOnly": "npm run build",
    "admin-cli": "ts-node src/admin.ts",
    "perf:audit": "ts-node scripts/perf-audit.ts"
  },
  "type": "commonjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1013.0",
    "@aws-sdk/util-utf8-node": "^3.259.0",
    "@types/dompurify": "^3.0.5",
    "@types/marked": "^5.0.2",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.1",
    "crypto-browserify": "^3.12.1",
    "dompurify": "^3.4.13",
    "events": "^3.3.0",
    "fs-extra": "^11.3.3",
    "html5-qrcode": "^2.3.8",
    "idb": "^8.0.3",
    "marked": "^18.0.4",
    "path-browserify": "^1.0.1",
    "peer": "^1.0.2",
    "peerjs": "^1.5.5",
    "process": "^0.11.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sql.js": "^1.13.0",
    "stream-browserify": "^3.0.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^6.0.3",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.0",
    "brace-expansion": "^2.1.4",
    "browserslist": "^4.28.7",
    "js-yaml": "^4.1.1",
    "qs": "^6.15.4",
    "body-parser": "^1.20.7",
    "baseline-browser-mapping": "^2.11.0",
    "@babel/core": "^7.29.1",
    "diff": "^4.0.4",
    "vite": "^6.4.3",
    "@docsearch/react": {
      "react": "$react",
      "react-dom": "$react-dom",
      "@types/react": "$@types/react"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.59.1",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@types/web-bluetooth": "^0.0.21",
    "esbuild": "^0.28.2",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.2.0",
    "jimp": "^1.6.1",
    "jsdom": "^30.1.0",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "vitepress": "^1.6.4"
  }
}
