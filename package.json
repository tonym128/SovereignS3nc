{
  "name": "sovereigns3nc",
  "version": "2.0.1",
  "description": "",
  "main": "dist/index.js",
  "bin": {
    "sov": "dist/cli.js",
    "sov-admin": "dist/admin.js"
  },
  "module": "dist/sovereigns3nc.esm.js",
  "unpkg": "dist/sovereigns3nc.global.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.integration.config.js",
    "test:docker": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.integration.config.js",
    "setup:test-env": "bash dev.sh start",
    "test:demo": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.demo.config.js",
    "test:shopping": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.shopping.config.js",
    "test:browser": "NODE_OPTIONS=--experimental-vm-modules npx playwright test",
    "build:esm": "esbuild src/index.ts --bundle --minify --platform=browser --outfile=dist/sovereigns3nc.esm.js --sourcemap --format=esm --alias:crypto=crypto-browserify --alias:path=path-browserify --alias:stream=stream-browserify --alias:buffer=buffer --alias:util=util --alias:events=events --alias:assert=assert --alias:process=process/browser --external:fs-extra --external:path --external:fs",
    "build:global": "esbuild src/index.ts --bundle --minify --platform=browser --outfile=dist/sovereigns3nc.global.js --sourcemap --format=iife --global-name=Sovereign --alias:crypto=crypto-browserify --alias:path=path-browserify --alias:stream=stream-browserify --alias:buffer=buffer --alias:util=util --alias:events=events --alias:assert=assert --alias:process=process/browser --external:fs-extra --external:path --external:fs",
    "build:social": "node demo/social/build.js",
    "build:banky": "node demo/banky/build.js",
    "build": "tsc && npm run build:esm && npm run build:global",
    "prepublishOnly": "npm run build",
    "admin-cli": "ts-node src/admin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.969.0",
    "@aws-sdk/util-utf8-node": "^3.259.0",
    "@types/node": "^25.0.8",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "events": "^3.3.0",
    "fs-extra": "^11.3.3",
    "idb": "^8.0.3",
    "path-browserify": "^1.0.1",
    "peer": "^1.0.2",
    "peerjs": "^1.5.5",
    "process": "^0.11.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sql.js": "^1.13.0",
    "stream-browserify": "^3.0.0",
    "tweetnacl": "^1.0.3",
    "typescript": "^5.9.3",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2"
  },
  "overrides": {
    "fast-xml-parser": "5.5.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.9",
    "esbuild": "^0.27.2",
    "esbuild-plugin-polyfill-node": "^0.3.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.2.0",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2"
  }
}
