{
  "name": "sovereigns3nc",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "module": "dist/sovereigns3nc.esm.js",
  "unpkg": "dist/sovereigns3nc.global.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "jest",
    "test:docker": "jest -c jest.integration.config.js",
    "setup:test-env": "bash scripts/setup-garage.sh",
    "test:demo": "jest -c jest.demo.config.js",
    "test:shopping": "jest -c jest.shopping.config.js",
    "build:esm": "esbuild src/index.ts --bundle --minify --platform=browser --outfile=dist/sovereigns3nc.esm.js --sourcemap --format=esm",
    "build:global": "esbuild src/index.ts --bundle --minify --platform=browser --outfile=dist/sovereigns3nc.global.js --sourcemap --format=iife --global-name=Sovereign",
    "build": "tsc && npm run build:esm && npm run build:global",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
