{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jest", "node"],
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "sovereigns3nc": ["./src/index.ts"],
      "@sovereigns3nc/react": ["./packages/react/src/index.ts"]
    }
  },
  "include": ["src/**/*", "packages/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist", "packages/*/dist"]
}
